<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.9.0</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>
  </PropertyGroup>

  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeBuild">
  <PropertyGroup>
    <BuildTimestamp>$([System.DateTime]::Now.ToString("yyMMdd-HHmm"))</BuildTimestamp>
  </PropertyGroup>
  <WriteLinesToFile
    File="$(ProjectDir)BuildInfo.cs"
    Lines="namespace AudioHexViewer { internal static class BuildInfo { public const string Timestamp = &quot;$(BuildTimestamp)&quot;%3B } }"
    Overwrite="true" />
</Target>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Nullable reference warnings: codebase not yet fully annotated, suppress false positives -->
    <NoWarn>$(NoWarn);8602;8604;8618;8619;8620;8621;8622;8625;8669</NoWarn>
    <!-- Designer / generated code -->
    <NoWarn>$(NoWarn);8625;0169;0219</NoWarn>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
	  <!-- IMPORTANT pour un EXE unique autonome -->
	  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
	  <SelfContained>true</SelfContained>
	  <PublishSingleFile>true</PublishSingleFile>
	  <PublishTrimmed>false</PublishTrimmed>
	  <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	  <ApplicationIcon>AudioHexViewer_big.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="HistogramForm.cs" />  <!-- doublon : HistogramForm déjà défini ailleurs dans le projet -->
    <Compile Remove="HistogramWindow.cs" />
    <Compile Remove="HistogramWindow.Designer.cs" />
    <Compile Remove="ThdSettingsDialog_Code.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="HistogramWindow.resx" />
    <EmbeddedResource Remove="ThdSettingsDialog_Code.resx" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Form1.cs.old" />
    <None Remove="Form1.Designer.cs.old" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="AudioHexViewer_big.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="WinForms.DataVisualization" Version="1.10.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\PublishProfiles\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="splash_bg.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


  <!-- ── Icônes de la toolbar (EmbeddedResource → chargées via GetManifestResourceStream) ── -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\*.png" />
  </ItemGroup>

  <!-- ── Toolbar : fichiers partiels Form1 ─────────────────────────────────── -->
  <ItemGroup>
    <Compile Update="Form1.Toolbar.cs">
      <SubType>Code</SubType>
      <DependentUpon>Form1.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- ── Phase 3 : fichiers partiels Form1 ────────────────────────────────── -->
  <!-- DependentUpon évite que le SDK WinForms les traite comme des contrôles  -->
  <!-- indépendants et tente de leur associer un .resx séparé.                 -->
  <ItemGroup>
    <Compile Update="Form1.AudioCapture.cs">
      <SubType>Code</SubType>
      <DependentUpon>Form1.cs</DependentUpon>
    </Compile>
    <Compile Update="Form1.FftDiagnostics.cs">
      <SubType>Code</SubType>
      <DependentUpon>Form1.cs</DependentUpon>
    </Compile>
    <Compile Update="Form1.FftPipeline.cs">
      <SubType>Code</SubType>
      <DependentUpon>Form1.cs</DependentUpon>
    </Compile>
    <Compile Update="Form1.FftTicker.cs">
      <SubType>Code</SubType>
      <DependentUpon>Form1.cs</DependentUpon>
    </Compile>
    <Compile Update="Form1.TestSignals.cs">
      <SubType>Code</SubType>
      <DependentUpon>Form1.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- ── Phase 4 : fichiers partiels SpectrumControl ──────────────────────── -->
  <!-- Même raison : SpectrumControl.resx ne doit être traité qu'une seule     -->
  <!-- fois, associé à SpectrumControl.cs uniquement.                          -->
  <ItemGroup>
    <Compile Update="SpectrumControl.Pipeline.cs">
      <SubType>Code</SubType>
      <DependentUpon>SpectrumControl.cs</DependentUpon>
    </Compile>
    <Compile Update="SpectrumControl.Rendering.cs">
      <SubType>Code</SubType>
      <DependentUpon>SpectrumControl.cs</DependentUpon>
    </Compile>
    <Compile Update="SpectrumControl.PostPaint.cs">
      <SubType>Code</SubType>
      <DependentUpon>SpectrumControl.cs</DependentUpon>
    </Compile>
    <Compile Update="SpectrumControl.Cursors.cs">
      <SubType>Code</SubType>
      <DependentUpon>SpectrumControl.cs</DependentUpon>
    </Compile>
    <Compile Update="SpectrumControl.Overlays.cs">
      <SubType>Code</SubType>
      <DependentUpon>SpectrumControl.cs</DependentUpon>
    </Compile>
    <Compile Update="SpectrumControl.Bode.cs">
      <SubType>Code</SubType>
      <DependentUpon>SpectrumControl.cs</DependentUpon>
    </Compile>
    <Compile Update="SpectrumControl.CursorsBar.cs">
      <SubType>Code</SubType>
      <DependentUpon>SpectrumControl.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- ── Ancre le .resx au fichier principal (lève toute ambiguïté MSBuild) ─ -->
  <ItemGroup>
    <EmbeddedResource Update="SpectrumControl.resx">
      <DependentUpon>SpectrumControl.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>


  <!-- ── Supprime les .resx fantômes auto-créés par VS sur les fichiers partiels ── -->
  <!-- VS génère des .resx vides quand il traite un partial comme un UserControl.    -->
  <!-- Ces fichiers vides causent MSB3577 car le SDK leur attribue le même           -->
  <!-- LogicalName que SpectrumControl.resx (via l'inspection de partial class).     -->
  <ItemGroup>
    <EmbeddedResource Remove="SpectrumControl.Pipeline.resx" />
    <EmbeddedResource Remove="SpectrumControl.Rendering.resx" />
    <EmbeddedResource Remove="SpectrumControl.PostPaint.resx" />
    <EmbeddedResource Remove="SpectrumControl.Cursors.resx" />
    <EmbeddedResource Remove="SpectrumControl.Overlays.resx" />
    <EmbeddedResource Remove="SpectrumControl.Bode.resx" />
    <EmbeddedResource Remove="SpectrumControl.CursorsBar.resx" />
    <None Remove="SpectrumControl.Pipeline.resx" />
    <None Remove="SpectrumControl.Rendering.resx" />
    <None Remove="SpectrumControl.PostPaint.resx" />
    <None Remove="SpectrumControl.Cursors.resx" />
    <None Remove="SpectrumControl.Overlays.resx" />
    <None Remove="SpectrumControl.Bode.resx" />
    <None Remove="SpectrumControl.CursorsBar.resx" />
  </ItemGroup>


  <!-- ── Tests unitaires ── Donne accès aux membres internal depuis AudioHexViewer.Tests -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AudioHexViewer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>


  <!-- GeneratorCalibrationDialog : designer imbriqué sous le fichier principal -->
  <ItemGroup>
    <Compile Update="GeneratorCalibrationDialog.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>GeneratorCalibrationDialog.cs</DependentUpon>
    </Compile>
  </ItemGroup>


  <!-- OscilloscopeControl : designer imbriqué sous le fichier principal -->
  <ItemGroup>
    <Compile Update="OscilloscopeControl.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>OscilloscopeControl.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
  <Content Include="doc\**\*">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </Content>
</ItemGroup>

</Project>
  <!-- PATCHED: GeneratorCalibrationDialog Designer dependency -->
