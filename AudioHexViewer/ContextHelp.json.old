  "btnAxisOpen":      "Open the X/Y axis configuration dialog.",
  "chkLogX":          "Toggle linear/logarithmic scale for the X-axis.",
  "btnOverlay":       "Open the Overlays manager",
  "btnPhiEnable":     "Show / hide the phase curve in Bode plot mode.",
  "btnPhiUnwrap":     "Toggle phase unwrapping — extends phase beyond ±180° for continuous display.",
  "btnFrfRefCapture": "Capture the current measurement as reference(H_ref). Right-click to access save/load/clear menu.",
  "btnFrfNormToggle": "Enable / disable FRF normalisation: H_corr = H_measured / H_ref.",

