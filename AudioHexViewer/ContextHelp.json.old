{
  // ── AudioHexViewer — Context Help Tooltips ───────────────────────────────
  // Key   = Control.Name (exact, case-sensitive)
  // Value = Tooltip text displayed on hover when context help is enabled
  // Edit freely — no recompile needed.
  // Supports // line comments and trailing commas.

  // ── Toolbar (Form1) ───────────────────────────────────────────────────────
  "tbDevices":     "Select audio input and output devices.",
  "tbGenerator":   "Signal Generator\nLeft-click: open dialog  |  Right-click: start / stop",
  "tbColors":      "Edit color palette.",
  "tbDataView":    "Open the DataView window — displays numeric FFT values and vu meters.",
  "tbAllFormats":  "Show all data formats simultaneously in the DataView.",
  "tbSidePanel":   "Show / hide the measurement side panel.",
  "tbAlwaysOnTop": "Keep this window always on top of other windows.",
  "tbCopy":        "Copy the current graph to the clipboard.",
  "tbPng":         "Export the current graph as a PNG image file.",
  "tbCsv":         "Export data to a CSV file.",
  "tbPdf":         "Export graphs in a PDF document.",
  "tbContextHelp": "Enable / disable context-sensitive tooltips",

  // ── Spectrum tab (SpectrumControl) ────────────────────────────────────────
  "comboChannel":     "Select the channel(s) to display: Left, Right, both or Bode Plot (Gain / Phase).",
