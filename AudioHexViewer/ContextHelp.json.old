  "btnResetAvg":      "Reset (clear) the FFT averaging accumulator.",
  "chkEnableThd":     "Enable THD+N measurement",
  "btnThdSettings":   "Open THD measurement settings",
  "chkPeakHold":      "MAXI hold: freeze trace on peak values.\nClick again to release. Right-click: reset the peak hold.",
